# Cadena de conexión a PostgreSQL
# Formato: postgresql://USUARIO:CONTRASEÑA@HOST:PUERTO/NOMBRE_BD?schema=public
DATABASE_URL="postgresql://postgres:TU_PASSWORD_SEGURO@localhost:5432/tienda_whatsapp?schema=public"

# Secreto para firmar tokens JWT — usa una cadena larga y aleatoria en producción
# Genera una con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="cambia_esto_por_un_secreto_largo_y_aleatorio"
